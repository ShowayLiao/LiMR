# Default: auto detect text files, normalize LF
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Jupyter notebooks
*.ipynb filter=lfs diff=lfs merge=lfs -text
*.ipynb linguist-generated=true

# Binary images (never modify line endings)
*.png binary -text -diff
*.jpg binary -text -diff
*.jpeg binary -text -diff
*.gif binary -text -diff
*.svg binary -text -diff
*.webp binary -text -diff
*.ico binary -text -diff
*.bmp binary -text -diff

# GitHub language statistics
.github/workflows/*.lock.yml linguist-generated=true merge=ours

# Generated outputs
output_limr/** linguist-generated=true
*.ckpt linguist-generated=true